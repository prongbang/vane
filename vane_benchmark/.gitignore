# Flutter/Dart/Pub related
# Untracked like the sibling packages'. tool/build_rhttp.sh reads the local
# lockfile at run time to find the resolved rhttp version; `flutter pub get`
# regenerates it.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Benchmark scratch: `results/latest.json` is whatever ran last (the Dart
# harness); `results/android-latest.json` likewise for VaneKotlin's
# bench-android.sh. A run worth keeping is copied to
# `results/<date>-<label>.json`, which IS tracked.
/results/latest.json
/results/android-latest.json
